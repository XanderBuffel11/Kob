<section class="hero wrap" aria-labelledby="hero-title">
  <h1 id="hero-title">{{ section.settings.heading | escape }}</h1>
  <p class="hero-lede">{{ section.settings.lede | escape }}</p>
  <ul class="chips" id="family-chips" aria-label="Scent families">
    <li><button type="button" class="chip" data-family="citrus" aria-pressed="false"><span class="chip-name">Citrus</span><span class="chip-blurb">Bright, sharp, awake</span></button></li>
    <li><button type="button" class="chip" data-family="floral" aria-pressed="false"><span class="chip-name">Floral</span><span class="chip-blurb">Soft, rosy, warm-skinned</span></button></li>
    <li><button type="button" class="chip" data-family="fresh" aria-pressed="false"><span class="chip-name">Fresh</span><span class="chip-blurb">Clean, airy, like rain</span></button></li>
    <li><button type="button" class="chip" data-family="woody" aria-pressed="false"><span class="chip-name">Woody</span><span class="chip-blurb">Dry, calm, grounded</span></button></li>
    <li><button type="button" class="chip" data-family="amber" aria-pressed="false"><span class="chip-name">Amber</span><span class="chip-blurb">Deep, sweet, lingering</span></button></li>
  </ul>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the scent that smells like you" },
    { "type": "textarea", "id": "lede", "label": "Intro text", "default": "Start with a family. Each one has its own mood, and the page will change colour to match." }
  ],
  "presets": [{ "name": "Kob hero" }]
}
{% endschema %}
