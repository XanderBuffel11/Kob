{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections['all']
  endif
-%}
<section class="shop wrap" id="shop" aria-labelledby="shop-title">
  <div class="shop-head">
    <h2 id="shop-title">{{ section.settings.heading | escape }}</h2>
    <form class="toolbar" id="search-form" role="search" novalidate>
      <label class="sr-only" for="search">Search fragrances</label>
      <input id="search" type="search" name="q" placeholder="Search by name or house" maxlength="60" autocomplete="off" spellcheck="false">
      <label class="sr-only" for="sort">Sort by</label>
      <select id="sort" name="sort">
        <option value="new">Newest</option>
        <option value="low">Price: low to high</option>
        <option value="high">Price: high to low</option>
        <option value="name">Name</option>
      </select>
    </form>
  </div>
  <p class="grid-status" aria-live="polite">
    <span id="grid-status"></span>
    <button type="button" class="link-button" id="clear-filters" hidden>Clear filters</button>
  </p>
  <ul class="grid" id="product-grid">
    {%- liquid
      assign shown = 0
      for product in source.products
        if section.settings.collection == blank and product.type != section.settings.product_type
          continue
        endif
        render 'kob-card', product: product, position: shown
        assign shown = shown | plus: 1
        if shown >= 48
          break
        endif
      endfor
    -%}
  </ul>
  {%- if shown == 0 -%}
    <p class="muted" id="grid-empty">New fragrances are on their way.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Fragrance shop",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fragrances" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Recommended: an automated collection where Product type equals Fragrance. If empty, the first 50 products of type below are shown." },
    { "type": "text", "id": "product_type", "label": "Product type to show when no collection is chosen", "default": "Fragrance" }
  ],
  "presets": [{ "name": "Kob fragrance shop" }]
}
{% endschema %}
