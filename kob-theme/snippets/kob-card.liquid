{%- comment -%} Product card. Usage: {% render 'kob-card', product: product %} {%- endcomment -%}
{%- assign family = '' -%}
{%- for tag in product.tags -%}
  {%- assign tag_lc = tag | downcase -%}
  {%- if tag_lc contains 'family:' -%}
    {%- assign family = tag_lc | remove: 'family:' | strip -%}
  {%- endif -%}
{%- endfor -%}
{%- assign card_alt = product.featured_image.alt | default: product.title -%}
<li
  data-family="{{ family | escape }}"
  data-title="{{ product.title | downcase | escape }} {{ product.vendor | downcase | escape }}"
  data-price="{{ product.price_min }}"
  data-order="{{ position | default: 0 }}"
>
  <a class="card" href="{{ product.url }}">
    <div class="media" data-family="{{ family | default: 'none' | escape }}">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '(min-width: 900px) 25vw, 50vw', alt: card_alt }}
      {%- endif -%}
    </div>
    <div class="card-body">
      <h3 class="card-title">{{ product.title | escape }}</h3>
      <p class="card-vendor">{{ product.vendor | escape }}</p>
      <p class="card-price">
        {%- if product.available -%}
          {%- if product.price_varies -%}From {% endif -%}{{ product.price_min | money }}
        {%- else -%}
          Sold out
        {%- endif -%}
      </p>
    </div>
  </a>
</li>
